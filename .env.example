# ─────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────

# JWT para sessão de usuário (qualquer string aleatória longa)
JWT_SECRET=troque_por_uma_string_secreta_longa

# ── APIs de IA ──────────────────────────────────────
# Groq — opção principal do chat CRI (rápido, gratuito com chave)
# Obter em: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude — fallback 1
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini — fallback para análise de CRI e oportunidades
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Vertex AI (Google Cloud) — autenticação OAuth2 via conta de serviço
# Prioridade sobre GEMINI_API_KEY. Para configurar:
#   1. Abra console.cloud.google.com → IAM → Contas de serviço
#   2. Crie uma conta com papel "Usuário da Vertex AI" (roles/aiplatform.user)
#   3. Gere uma chave JSON e salve como service-account.json na raiz do projeto
#   4. Defina abaixo o caminho para o arquivo
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_CLOUD_PROJECT=

# ── APIs de Busca ────────────────────────────────────
# SerpAPI — busca Google para novas emissões, ANBIMA e notícias
# Obter em: https://serpapi.com/
SERPAPI_API_KEY=

# GNews — notícias sobre CRI em português
# Obter em: https://gnews.io/
GNEWS_API_KEY=

# NewsAPI — notícias financeiras gerais
# Obter em: https://newsapi.org/
NEWS_API_KEY=

# ── Banco de Dados (MySQL) ───────────────────────────
# Para persistir oportunidades aprovadas/rejeitadas
# Formato: mysql://usuario:senha@host:porta/banco
DATABASE_URL=

# ── OAuth (opcional — apenas se usar login) ──────────
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
